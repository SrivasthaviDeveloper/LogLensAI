# Example only; no credentials or production endpoints belong here.
# ui.py reads VNSP_API_BASE_URL from the process environment. This file is
# documentation and is not loaded automatically by the current application.
VNSP_API_BASE_URL=http://127.0.0.1:8000

# Default source is local fabricated JSONL. SSH is opt-in; these are examples
# only. The local config must also explicitly enable and authorize 127.0.0.1:2222.
LOGLENS_LOG_SOURCE=mock
LOGLENS_SSH_HOST=127.0.0.1
LOGLENS_SSH_PORT=2222
LOGLENS_SSH_USER=loglens-demo
LOGLENS_SSH_AUTH_METHOD=private_key
LOGLENS_SSH_KEY=C:\\path\\to\\authorized-demo-key
LOGLENS_SSH_HOST_KEY_FILE=C:\\path\\to\\known_hosts
LOGLENS_REMOTE_LOG_ROOT=~/loglens/mock_logs
LOGLENS_SSH_TIMEOUT_SECONDS=5
LOGLENS_SSH_MAX_FILE_BYTES=5242880
LOGLENS_SSH_MAX_RECORDS=2000
# Set LOGLENS_SSH_PASSWORD in the process environment only if password auth is
# explicitly configured. Never store an actual password in this file.
VNSP_CLASSIFIER_MIN_CONFIDENCE=0.12
